# Dashboard/API port exposed by Docker Compose.
WEB_PORT=8088

# Gateway local API. Most current T-Mobile gateways use 192.168.12.1:8080.
GATEWAY_HOST=192.168.12.1
GATEWAY_PORT=8080
GATEWAY_USERNAME=admin
GATEWAY_PASSWORD=replace-with-the-gateway-admin-password

# Keep true for the first deployment. Change to false after testing /api/gateway/test.
DRY_RUN=true
WATCHDOG_ENABLED=true

# Internet must stay failed for this long before a reboot is considered.
CHECK_INTERVAL_SECONDS=20
FAILURE_THRESHOLD_SECONDS=180
STARTUP_GRACE_SECONDS=60

# Prevent reboot loops while the gateway starts and reconnects to cellular service.
POST_REBOOT_GRACE_SECONDS=480
REBOOT_COOLDOWN_SECONDS=1800
MAX_REBOOTS_PER_24H=3

# A round is online when at least this many independent probes pass.
PROBE_TIMEOUT_SECONDS=5
MINIMUM_SUCCESSFUL_PROBES=2
PROBE_URLS=https://connectivitycheck.gstatic.com/generate_204,https://www.cloudflare.com/cdn-cgi/trace,http://www.msftconnecttest.com/connecttest.txt

# Required for manual check, login-test, and reboot API calls.
API_TOKEN=replace-with-a-long-random-token

DATABASE_PATH=/data/watchdog.db
LOG_LEVEL=INFO

# Optional comma-separated origins for a separate browser UI.
CORS_ORIGINS=
